# Next.js runtime variables
NEXT_PUBLIC_SUPABASE_URL=https://xxewilxkoqdeqostcxtq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key. Keep the secret in Supabase Auth CAPTCHA settings,
# not in a NEXT_PUBLIC_* environment variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# AI provider keys do NOT belong in this browser-facing file.
# Configure OPENAI_API_KEY and model-role overrides in Supabase Edge Function Secrets.
# See: supabase/functions/.env.example and docs/ai-model-strategy.md

# Google and Microsoft OAuth client secrets also do NOT belong here.
# Configure those providers in Supabase Dashboard -> Authentication -> Providers.
# See: docs/auth-onboarding.md
