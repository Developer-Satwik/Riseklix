# Supabase Edge Function secrets / model role overrides
# Never commit a real provider key.

OPENAI_API_KEY=sk-your-openai-api-key

# High-intelligence commercial reasoning
RISEKLIX_COMPANY_MODEL=gpt-5.6-sol
RISEKLIX_INTENT_MODEL=gpt-5.6-sol
RISEKLIX_COMPETITOR_MODEL=gpt-5.6-sol
RISEKLIX_WHY_MODEL=gpt-5.6-sol

# Implementation drafting
RISEKLIX_BLUEPRINT_MODEL=gpt-5.6-terra

# High-volume / low-cost utility work
RISEKLIX_PROMPT_MODEL=gpt-5.6-luna
RISEKLIX_EXTRACTION_MODEL=gpt-5.6-luna

# Market-observation proxy
# ChatGPT Free currently uses GPT-5.6 Luna. This API surface is only an approximation
# of the consumer Free experience, not the ChatGPT app itself.
RISEKLIX_OPENAI_OBSERVATION_MODEL=gpt-5.6-luna
